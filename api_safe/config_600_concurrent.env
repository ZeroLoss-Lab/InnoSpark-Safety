# 匹配原始API 600并发能力配置 🚀

# ===================
# 基础服务配置
# ===================
VLLM_API_BASE=http://localhost:8000
VLLM_API_KEY=

HOST=0.0.0.0
PORT=8001

# ===================
# 高并发600配置 🚀
# ===================
# 多进程模式以支持高并发（建议设置为CPU核心数的1-2倍）
WORKERS=8

# 精确匹配600并发 + 缓冲
# 总连接数：600并发 + 30%缓冲 = 800
MAX_CONNECTIONS=800                    # 总连接数池
MAX_KEEPALIVE_CONNECTIONS=600          # 保持活跃连接=原始API并发数

# ===================
# API Key配置
# ===================
# 支持多API key（保持原有功能）
API_KEY=your-api-key-600-concurrent
ENABLE_MULTI_API_KEYS=true
API_KEYS_FILE=api_keys.json

# ===================
# 文档配置
# ===================
ENABLE_DOCS=true
DOCS_REQUIRE_AUTH=true

# ===================
# 日志配置（高并发优化）
# ===================
LOG_LEVEL=WARNING      # 减少日志IO开销
LOG_FILE=logs/api.log
USER_LOG_FILE=logs/user_requests.log 