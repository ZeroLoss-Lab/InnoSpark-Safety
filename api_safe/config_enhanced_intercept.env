# 增强版拦截器配置文件示例
# 使用方法：cp config_enhanced_intercept.env .env

# ===== vLLM API配置 =====
VLLM_API_BASE=http://localhost:8000
VLLM_API_KEY=

# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8001
WORKERS=1

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_FILE=logs/api.log
USER_LOG_FILE=logs/user_requests.log

# ===== API密钥配置 =====
API_KEY=your_api_key_here
ENABLE_MULTI_API_KEYS=true
API_KEYS_FILE=api_keys.json

# ===== 文档安全配置 =====
ENABLE_DOCS=true
DOCS_REQUIRE_AUTH=true

# ===== 拦截器核心配置 =====
# 启用前拦截（必须）
ENABLE_FRONT_INTERCEPT=true
# 启用后拦截（推荐）
ENABLE_POST_INTERCEPT=true
# 使用本地集成模式（推荐，性能更好）
USE_LOCAL_INTERCEPT=true

# ===== 拦截器模型路径 =====
MODEL_FRONT_PATH=./safe_api/models/front_model
MODEL_POST_PATH=./safe_api/models/post_model

# ===== 关键词数据路径 =====
# 高敏感关键词（第一层拦截）
HIGH_SENSITIVE_KEYWORDS_PATH=./safe_api/data/high_sensitive_keywords.json
# 次高敏感关键词（第三层拦截）
MEDIUM_SENSITIVE_KEYWORDS_PATH=./safe_api/data/high_sensitive_keywords-2.json
# 1w黑名单
BLACKLIST_1W_PATH=./safe_api/data/blacklist_1w.json

# ===== BERT双阈值配置 =====
# 前拦截高阈值（>=此值直接拦截）
BERT_FRONT_HIGH_THRESHOLD=0.97
# 前拦截低阈值（>此值但<高阈值时进入中间判断）
BERT_FRONT_LOW_THRESHOLD=0.00002
# 后拦截阈值
BERT_POST_THRESHOLD=0.5

# ===== RAG系统配置 =====
# 启用RAG系统（核心功能）
ENABLE_RAG=true
# RAG检索服务地址
RAG_SERVICE_URL=http://localhost:8000/retrieve
# RAG返回的top-k结果数量
RAG_TOP_K=5
# RAG服务超时时间（秒）
RAG_TIMEOUT=10.0

# ===== 超时配置 =====
INTERCEPT_TIMEOUT=5.0

# ===== 远程API配置（如果不使用本地模式） =====
FRONT_INTERCEPT_URL=http://localhost:8001/intercept
POST_INTERCEPT_URL=http://localhost:8002/intercept
