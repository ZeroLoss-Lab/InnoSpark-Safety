# vLLM Proxy API 配置文件

# ===================
# 基础服务配置
# ===================
# vLLM API地址
VLLM_API_BASE=http://localhost:8000
# vLLM API密钥（可选）
VLLM_API_KEY=

# 服务绑定地址和端口
HOST=0.0.0.0
PORT=8001

# ===================
# 高并发性能配置 🚀
# ===================
# Worker进程数量（生产环境建议设置为CPU核心数，如：4, 8, 16）
# 单进程适合开发，多进程适合生产高并发
WORKERS=1

# HTTP连接池配置 - 关键性能参数！
# 最大连接数（支持的并发请求数上限）
MAX_CONNECTIONS=200
# 保持活跃连接数（复用连接，减少连接建立开销）
MAX_KEEPALIVE_CONNECTIONS=100

# ===================
# 安全配置
# ===================
# 单个API密钥（简单模式）
API_KEY=your-secret-api-key

# 多API密钥支持
ENABLE_MULTI_API_KEYS=true
API_KEYS_FILE=api_keys.json

# ===================
# 文档配置
# ===================
# 是否启用API文档
ENABLE_DOCS=true
# 文档是否需要认证
DOCS_REQUIRE_AUTH=true

# ===================
# 日志配置
# ===================
LOG_LEVEL=INFO
LOG_FILE=logs/api.log
USER_LOG_FILE=logs/user_requests.log

# ===================
# 内容拦截配置
# ===================
# 是否启用前拦截（用户输入检查）
ENABLE_FRONT_INTERCEPT=false
# 是否启用后拦截（模型输出检查）
ENABLE_POST_INTERCEPT=false

# 拦截API地址（当use_local_intercept=false时使用）
FRONT_INTERCEPT_URL=http://localhost:8001/intercept
POST_INTERCEPT_URL=http://localhost:8002/intercept

# 是否使用本地集成模式（true=直接集成到主API，false=调用独立拦截API）
USE_LOCAL_INTERCEPT=true

# 拦截模型路径配置（本地集成模式）
MODEL_FRONT_PATH=./safe_api/models/front_model
MODEL_POST_PATH=./safe_api/models/post_model
BLACKLIST_1W_PATH=./safe_api/data/blacklist_1w.json
HIGH_SENSITIVE_KEYWORDS_PATH=./safe_api/data/high_sensitive_keywords.json

# 拦截API超时时间（秒）
INTERCEPT_TIMEOUT=5.0 