# 匹配原始API并发能力配置 - 200并发

# ===================
# 基础服务配置
# ===================
VLLM_API_BASE=http://localhost:8000
VLLM_API_KEY=

HOST=0.0.0.0
PORT=8001

# ===================
# 匹配原始API并发配置 🎯
# ===================
# 单进程模式（避免多进程开销，匹配原始API架构）
WORKERS=1

# 精确匹配200并发
# 原始API能支持200并发，我们配置稍高以确保不成为瓶颈
MAX_CONNECTIONS=250                    # 总连接数，留25%缓冲
MAX_KEEPALIVE_CONNECTIONS=200          # 保持活跃连接=原始API并发数

# ===================
# API Key配置
# ===================
# 支持多API key（保持原有功能）
API_KEY=your-api-key
ENABLE_MULTI_API_KEYS=true
API_KEYS_FILE=api_keys.json

# ===================
# 文档配置
# ===================
ENABLE_DOCS=true
DOCS_REQUIRE_AUTH=true

# ===================
# 日志配置
# ===================
LOG_LEVEL=INFO
LOG_FILE=logs/api.log
USER_LOG_FILE=logs/user_requests.log 