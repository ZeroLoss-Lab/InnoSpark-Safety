# 生产环境高并发配置 - 支持200+并发

# ===================
# 基础服务配置
# ===================
VLLM_API_BASE=http://localhost:8000
VLLM_API_KEY=

HOST=0.0.0.0
PORT=8001

# ===================
# 生产环境高并发配置 🚀
# ===================
# 多Worker进程（根据你的CPU核心数调整）
WORKERS=4

# 高并发连接池配置
# 支持200+并发连接
MAX_CONNECTIONS=500
MAX_KEEPALIVE_CONNECTIONS=200

# ===================
# 生产环境安全配置
# ===================
# 强烈建议使用强密钥
API_KEY=prod-super-secret-key-2024

# 启用多API密钥管理
ENABLE_MULTI_API_KEYS=true
API_KEYS_FILE=api_keys.json

# ===================
# 生产环境文档配置
# ===================
# 生产环境建议禁用文档或需要认证
ENABLE_DOCS=false
DOCS_REQUIRE_AUTH=true

# ===================
# 生产环境日志配置
# ===================
LOG_LEVEL=WARNING
LOG_FILE=logs/api.log
USER_LOG_FILE=logs/user_requests.log 